# Environment variables
PORT=3000

# SMTP Email Configuration (Google Workspace / Gmail or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rohit@yellobit.com
SMTP_PASS=

# Optional alternative: Resend HTTP API (if you prefer Resend instead of SMTP)
RESEND_API_KEY=
RESEND_FROM=

# Recipients for contact form booking inquiries (comma-separated)
CONTACT_RECEIVER_EMAIL=moosshibi@gmail.com, rohit@yellobit.com
CONTACT_SENDER_EMAIL=rohit@yellobit.com
CONTACT_SENDER_NAME=MoosB Web Contact Request
